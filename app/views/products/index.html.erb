
<h1>商品一覧</h1>

<%= link_to "商品を登録", new_product_path %>
<%= link_to "カートを見る", cart_path(current_cart) %>

<table border="1">
  <tr>
    <th>商品名</th>
    <th>価格</th>
    <th>操作</th>
  </tr>

  <% @products.each do |product| %>
    <tr>
      <td><%= product.name %></td>
      <td><%= product.price %>円</td>
      <td>
        <%= link_to "カートに追加", new_cartitem_path(product_id: product.id) %>
        <%= button_to "削除", product_path(product), method: :delete %>
      </td>
    </tr>
  <% end %>
</table>
