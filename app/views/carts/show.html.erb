
<h1>ショッピングカート</h1>

<table border="1">
  <tr>
    <th>商品名</th>
    <th>価格</th>
    <th>数量</th>
    <th>小計</th>
    <th>操作</th>
  </tr>

  <% @cart_items.each do |item| %>
    <tr>
      <td><%= item.product.name %></td>
      <td><%= item.product.price %>円</td>
      <td><%= item.qty %></td>
      <td><%= item.product.price * item.qty %>円</td>
      <td>
        <%= button_to "削除", cartitem_path(item), method: :delete %>
      </td>
    </tr>
  <% end %>
</table>

<p>合計金額：<%= @total %>円</p>

<%= link_to "商品一覧に戻る", products_path %>
